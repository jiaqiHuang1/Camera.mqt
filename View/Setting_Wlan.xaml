<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Camera.ViewModel"
             x:Class="Camera.View.Setting_Wlan"
             BackgroundColor="White"
             Title="WiFi Settings">

    <!-- Bind ViewModel -->
    <ContentPage.BindingContext>
        <viewmodel:WifiViewModel/>
    </ContentPage.BindingContext>

    <!-- Main Layout -->
    <StackLayout Padding="40" Spacing="30">

        <!-- Status Message -->
        <Label Text="{Binding StatusMessage}" 
               FontAttributes="Bold" 
               TextColor="Red"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="Medium"/>

        <!-- Connect to Server Button -->
        <Button Text="Connect to Server"
                Command="{Binding ConnectToServerCommand}"
                IsEnabled="{Binding IsnotConnected}"
                HorizontalOptions="Center"
                WidthRequest="250"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#007AFF"
                TextColor="White"
                FontAttributes="Bold"/>

        <!-- WiFi SSID Input -->
        <Frame BackgroundColor="#F5F5F5"
               CornerRadius="10"
               Padding="10"
               Margin="0,10">
            <Entry Placeholder="WiFi SSID"
                   Text="{Binding SSID}"
                   IsEnabled="{Binding IsConnected}"
                   HorizontalOptions="FillAndExpand"
                   TextColor="Black"/>
        </Frame>

        <!-- WiFi Password Input -->
        <Frame BackgroundColor="#F5F5F5"
               CornerRadius="10"
               Padding="10">
            <Entry Placeholder="WiFi Password"
                   Text="{Binding Password}"
                   IsEnabled="{Binding IsConnected}"
                   IsPassword="True"
                   HorizontalOptions="FillAndExpand"
                   TextColor="Black"/>
        </Frame>

        <!-- Connect to WiFi Button -->
        <Button Text="Connect to WiFi"
                Command="{Binding SendWifiCredentialsCommand}"
                IsEnabled="{Binding IsConnected}"
                HorizontalOptions="Center"
                WidthRequest="250"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#34C759"
                TextColor="White"
                FontAttributes="Bold"/>

        <!-- Disconnect Button -->
        <Button Text="Disconnect"
                Command="{Binding DisconnectCommand}"
                IsEnabled="{Binding IsConnected}"
                HorizontalOptions="Center"
                WidthRequest="250"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#FF3B30"
                TextColor="White"
                FontAttributes="Bold"/>
    </StackLayout>
</ContentPage>
